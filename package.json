{
  "name": "wheel-and-form",
  "version": "0.2.0",
  "description": "Local-first file workshop for Windows. Convert, compress, extract, and transform files without uploading them.",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "release:win": "electron-builder --win --publish always",
    "lint": "echo ok"
  },
  "author": "Wheel and Form contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nolane-x/Wheel-and-form.git"
  },
  "build": {
    "appId": "com.wheelandform.app",
    "productName": "Wheel and Form",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/bin/WheelAndFormDragHook.exe",
        "to": "native/WheelAndFormDragHook.exe"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Wheel-and-Form-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Nolane-x",
        "repo": "Wheel-and-form",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^25.0.0"
  }
}
