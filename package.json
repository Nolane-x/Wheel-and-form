{
  "name": "wheel-and-form",
  "version": "0.1.0",
  "description": "Local-first file workshop for Windows. Convert, compress, extract, and transform files without uploading them.",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "lint": "echo ok"
  },
  "author": "Wheel and Form contributors",
  "license": "MIT",
  "build": {
    "appId": "com.wheelandform.app",
    "productName": "Wheel and Form",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/bin/WheelAndFormDragHook.exe",
        "to": "native/WheelAndFormDragHook.exe"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^25.0.0"
  }
}
